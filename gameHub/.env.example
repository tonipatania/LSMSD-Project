# Copia in .env (mai committare .env) o imposta queste variabili nel pannello
# "Environment" del servizio di hosting (es. Render). Ogni variabile ha un default
# di sviluppo locale in application.properties: qui sotto i valori attesi in produzione.

# --- MongoDB (es. MongoDB Atlas, cluster M0 free tier) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/game?retryWrites=true&w=majority

# --- Neo4j (es. Neo4j Aura Free) ---
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<password-generata-da-aura>

# --- Redis (es. Upstash, free tier) ---
REDIS_HOST=<endpoint>.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=<token-upstash>
REDIS_SSL=true
REDIS_DATABASE=0

# --- JWT ---
# Genera con: openssl rand -hex 32
GAMEHUB_JWT_SECRET=<64-hex-char-random-secret>

# --- CORS ---
# Dominio/i di produzione del frontend Vercel, separati da virgola (no slash finale).
GAMEHUB_CORS_ORIGINS=https://<il-tuo-progetto>.vercel.app

# --- Porta (impostata automaticamente da Render tramite PORT, di solito non va toccata) ---
PORT=8080
