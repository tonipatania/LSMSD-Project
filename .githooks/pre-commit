#!/usr/bin/env bash
# Pre-commit hook: format staged Java files with Spotless and lint them with Checkstyle.
# Installed via: git config core.hooksPath .githooks (already set for this repo).

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACM -- 'gameHub/*.java')

if [ -z "$STAGED_JAVA_FILES" ]; then
    exit 0
fi

cd "$REPO_ROOT/gameHub"

echo "Running Spotless (format)..."
./mvnw -q spotless:apply

# Re-stage files in case Spotless reformatted them.
cd "$REPO_ROOT"
echo "$STAGED_JAVA_FILES" | xargs git add

cd "$REPO_ROOT/gameHub"

echo "Running Checkstyle (lint)..."
if ! ./mvnw -q checkstyle:check; then
    echo ""
    echo "Checkstyle found violations. Fix them before committing."
    exit 1
fi

exit 0
